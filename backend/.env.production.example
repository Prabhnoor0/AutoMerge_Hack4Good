# AutoMerge Backend — Production Environment Variables
# Set these in Render Dashboard → Environment Variables

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database (Render provides PostgreSQL, or keep SQLite for demo)
DATABASE_URL=sqlite+aiosqlite:///./data/automerge.db

# CORS — your Vercel frontend domain (CRITICAL for cross-origin requests)
CORS_ORIGINS=["https://automerge-frontend.vercel.app"]

# Authentication — USE A STRONG SECRET IN PRODUCTION
JWT_SECRET=your-strong-random-secret-here

# Demo mode
DEMO_MODE=True

# Agent settings
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=30

# Optional: LLM API keys
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...

# Optional: GitHub
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=your-repo-name
