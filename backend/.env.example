# AutoMerge Backend — Environment Variables
# Copy to .env and fill in values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/automerge.db

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Demo mode (enables demo scenarios)
DEMO_MODE=True

# Optional: Default GitHub credentials (tokens are passed per-request in the UI)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=your-repo-name

# Optional: LLM API keys (for future AI-powered analysis)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Optional: Slack webhook for notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Agent settings
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=30
